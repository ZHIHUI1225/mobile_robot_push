{
  "name": "epuck-mujoco",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "containerEnv": {
    "MUJOCO_GL": "egl",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility,graphics"
  },
  "runArgs": ["--gpus=all"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "python -m pip install -e '.[dev]'",
  "remoteUser": "root"
}
